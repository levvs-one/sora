# Line endings are normalised in the repository and checked out as LF, so a
# contribution from Windows never rewrites the line endings of a whole file and
# gofmt never reports a clean file as unformatted.
* text=auto eol=lf

# Never treat these as text.
*.png binary
*.ico binary
*.jpg binary
*.gz binary
*.suo binary
*.zip binary
*.minisig binary
*.mmdb binary
*.dat binary
*.db binary
*.dll binary
*.exe binary
*.snk binary
*.pdb binary

# Keep the upstream licence texts verbatim, including their original whitespace.
packaging/engines/winws-licenses/*.txt -whitespace
