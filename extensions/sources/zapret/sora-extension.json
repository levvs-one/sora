{
  "manifest_version": 1,
  "id": "org.sora.zapret",
  "name": "Zapret",
  "version": "1.1.1",
  "min_app_version": "1.1.6",
  "description": "Blocking bypass without a VPN: reshapes the start of connections so the provider cannot recognise the site. A panel shows its state and switches profiles.",
  "author": {
    "name": "Sora",
    "identity": "github:levvs-one",
    "public_key": "RWQZfr8pZOLhNx/81iyyYi91cZMQTyJece9fX9OWIJoUqMPpN7eCYk/+"
  },
  "permissions": [
    "net.hooks",
    "ui.panel"
  ],
  "capabilities": [
    "network-hook",
    "ui-panel"
  ],
  "ui": {
    "panels": [
      {
        "id": "main",
        "title": "Zapret",
        "entry": "panel.html"
      }
    ]
  },
  "network_hook": {
    "entry": "hook.json"
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "profile": {
        "type": "string",
        "title": "DPI",
        "enum": [
          "TCP+TLS",
          "TLS",
          "HTTP"
        ],
        "default": "TCP+TLS"
      }
    }
  }
}
