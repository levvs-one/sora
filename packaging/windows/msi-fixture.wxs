<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.Product)" UpgradeCode="$(var.Upgrade)" Name="Sora MSI transaction fixture"
           Version="$(var.Version)" Manufacturer="Sora tests" Language="1033">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"/>
    <Media Id="1" Cabinet="fixture.cab" EmbedCab="yes"/>
    <Property Id="PROBEFAIL" Value="0"/>
    <Upgrade Id="$(var.Upgrade)">
      <UpgradeVersion Minimum="0.0.0" Maximum="$(var.Version)" Property="FIXTURE_PREVIOUS" IncludeMaximum="no"/>
    </Upgrade>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="SoraMSITransactionFixture">
          <Component Id="PayloadComponent" Guid="$(var.Component)" Win64="yes">
            <File Id="Payload" Source="$(var.Input)/payload.txt" KeyPath="yes"/>
            <File Id="ProbeExe" Source="$(var.Input)/probe.exe"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Fixture" Level="1"><ComponentRef Id="PayloadComponent"/></Feature>
    <CustomAction Id="ProbeReady" FileKey="ProbeExe" Execute="deferred" Impersonate="yes" Return="check"
                  ExeCommand="&quot;[#Payload]&quot; &quot;[OBSERVATION]&quot; $(var.Expected) [PROBEFAIL]"/>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize"/>
      <Custom Action="ProbeReady" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
