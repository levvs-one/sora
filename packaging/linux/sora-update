#!/bin/sh
# pkexec authorizes only this root-owned entry point. Package managers receive
# a private snapshot so the caller cannot change a file after verification.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

die() { printf 'sora-update: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die 'administrator rights are required'
# The app's automatic rollback (app/lib/src/updates.dart) installs the
# previous release and says so with --allow-downgrade; without it an older
# version is refused, so a direct call cannot silently downgrade.
allow_downgrade=
case "$#" in
3) ;;
4)
    [ "$4" = --allow-downgrade ] || die 'the fourth argument must be --allow-downgrade'
    allow_downgrade=1
    ;;
*) die 'expected format, version, download directory and optional --allow-downgrade' ;;
esac
format=$1 version=$2 source=$3

# version_ge reports whether dotted-numeric A >= B.
version_ge() {
    _i=1
    while [ "$_i" -le 3 ]; do
        _x=$(printf '%s' "$1" | cut -d. -f"$_i")
        _y=$(printf '%s' "$2" | cut -d. -f"$_i")
        [ "$_x" -gt "$_y" ] && return 0
        [ "$_x" -lt "$_y" ] && return 1
        _i=$((_i + 1))
    done
    return 0
}
printf '%s\n' "$version" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || die 'invalid version'
case "$source" in /*) ;; *) die 'download directory must be absolute' ;; esac
[ "$(uname -m)" = x86_64 ] || die 'the desktop update requires x86_64'
case "$format" in
deb)
    files="sora-core_${version}_amd64.deb sora_${version}_amd64.deb"
    case "$(dpkg-query -S /usr/lib/sora/app/sora)" in
        'sora: /usr/lib/sora/app/sora' | 'sora:amd64: /usr/lib/sora/app/sora') ;;
        *) die 'Sora was not installed with dpkg' ;;
    esac
    for package in sora sora-core; do
        [ "$(dpkg-query -W -f='${db:Status-Status}' "$package")" = installed ] || die 'both packages must be installed'
    done
    ;;
rpm)
    files="sora-core-${version}-1.x86_64.rpm sora-${version}-1.x86_64.rpm"
    [ "$(rpm -qf --qf '%{NAME}' /usr/lib/sora/app/sora)" = sora ] || die 'Sora was not installed with rpm'
    rpm -q sora sora-core >/dev/null || die 'both packages must be installed'
    ;;
arch)
    files="sora-core-${version}-1-x86_64.pkg.tar.zst sora-${version}-1-x86_64.pkg.tar.zst"
    [ "$(pacman -Qoq /usr/lib/sora/app/sora)" = sora ] || die 'Sora was not installed with pacman'
    pacman -Q sora sora-core >/dev/null || die 'both packages must be installed'
    ;;
*) die 'unsupported package format' ;;
esac

installed_version() {
    case "$format" in
    deb) dpkg-query -W -f='${Version}' sora-core ;;
    rpm) rpm -q --qf '%{VERSION}' sora-core ;;
    arch) pacman -Q sora-core | awk '{print $2}' | sed 's/-[^-]*$//' ;;
    esac
}
current=$(installed_version)
printf '%s\n' "$current" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || die "cannot determine the installed version ('$current')"
downgrade=
if ! version_ge "$version" "$current"; then
    [ -n "$allow_downgrade" ] || die "downgrade from $current to $version refused; pass --allow-downgrade to override"
    downgrade=1
fi

work=$(mktemp -d /var/tmp/sora-update.XXXXXXXX)
trap 'rm -rf "$work"' EXIT HUP INT TERM
snapshot_files="SHA256SUMS SHA256SUMS.minisig $files"
if [ -e "$source/release.json" ] || [ -L "$source/release.json" ]; then snapshot_files="$snapshot_files release.json"; fi
for name in $snapshot_files; do
    if [ ! -f "$source/$name" ] || [ -L "$source/$name" ]; then die 'downloads must be regular files'; fi
    cp -P -- "$source/$name" "$work/$name"
    # cp -P preserves a symlink raced into the source, which is then rejected.
    if [ ! -f "$work/$name" ] || [ -L "$work/$name" ]; then die 'a download changed during copying'; fi
done
# Use the installed trust root, never a verifier supplied with the download.
/usr/bin/sora-core -verify-release "$work" -release-version "$version" || die 'release signature verification failed; nothing was installed'
cd "$work"
checked_files=$files
if grep -Eq ' [ *]release[.]json$' SHA256SUMS; then
    if [ ! -f release.json ] || [ ! -s release.json ] || [ -L release.json ]; then die 'release metadata is missing or empty'; fi
    [ "$(wc -c <release.json)" -le 1048576 ] || die 'release metadata is too large'
    checked_files="$checked_files release.json"
elif [ -e release.json ]; then
    die 'release metadata is not authenticated by the checksum manifest'
fi
for name in $checked_files; do
    if [ "$name" != release.json ]; then
        size=$(/usr/bin/sora-core -verify-release "$work" -release-version "$version" -release-artifact "$name" -release-target linux/amd64) || die 'artifact metadata rejected'
        case "$size" in '' | *[!0-9]*) die 'invalid verifier size response' ;; esac
        if [ "${#size}" -gt 10 ] || [ "$size" -gt 2147483648 ]; then die 'invalid verifier size response'; fi
        bytes=$(wc -c <"$name")
        if [ "$bytes" -lt 1 ] || [ "$bytes" -gt 2147483648 ]; then die 'invalid package size'; fi
        if [ "$size" -gt 0 ] && [ "$bytes" -ne "$size" ]; then die 'signed package size mismatch'; fi
    fi
    # Match the filename literally, including the dots in release versions.
    awk -v name="$name" 'length($1) == 64 && $1 !~ /[^0-9a-fA-F]/ && (substr($0, 67) == name || substr($0, 67) == "*" name) {print tolower($1) "  " name; count++} END {if (count != 1) exit 1}' SHA256SUMS >>expected || die 'missing or duplicate checksum'
done
sha256sum -c --quiet expected || die 'checksum mismatch; nothing was installed'

for package in sora-core sora; do
    case "$format" in
    deb)
        file="${package}_${version}_amd64.deb"
        [ "$(dpkg-deb -f "$file" Package)" = "$package" ] || die 'unexpected package name'
        [ "$(dpkg-deb -f "$file" Version)" = "$version" ] || die 'unexpected package version'
        [ "$(dpkg-deb -f "$file" Architecture)" = amd64 ] || die 'unexpected architecture'
        ;;
    rpm)
        file="${package}-${version}-1.x86_64.rpm"
        [ "$(rpm -qp --qf '%{NAME} %{VERSION}-%{RELEASE} %{ARCH}' "$file")" = "$package $version-1 x86_64" ] || die 'unexpected package metadata'
        ;;
    arch)
        file="${package}-${version}-1-x86_64.pkg.tar.zst"
        [ "$(pacman -Qp "$file")" = "$package $version-1" ] || die 'unexpected package metadata'
        ;;
    esac
done

set --
for name in $files; do set -- "$@" "$work/$name"; done
case "$format" in
deb)
    if [ -n "$downgrade" ]; then
        apt-get install -y --allow-downgrades "$@"
    else
        apt-get install -y "$@"
    fi
    ;;
rpm)
    if command -v dnf >/dev/null 2>&1; then
        if [ -n "$downgrade" ]; then dnf downgrade -y "$@"; else dnf install -y "$@"; fi
    elif command -v zypper >/dev/null 2>&1; then
        if [ -n "$downgrade" ]; then
            zypper --non-interactive install --oldpackage --allow-unsigned-rpm "$@"
        else
            zypper --non-interactive install --allow-unsigned-rpm "$@"
        fi
    else
        die 'dnf or zypper is required'
    fi
    ;;
arch)
    # Existing installations may predate the browser's audio dependency.
    pacman -S --noconfirm --needed gst-plugins-good
    pacman -U --noconfirm "$@"
    ;;
esac
