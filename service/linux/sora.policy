<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Read-only access (status, statistics, events, logs) stays passwordless for
  the active local session, as with the network settings of a desktop.
  Anything that changes the tunnel or touches secrets and subscriptions
  requires the user's own authentication. Remote and inactive sessions need an
  administrator for both. The owner annotation lets the core, which runs as the
  sora user and not as root, ask polkit about the processes that connect to it.
-->
<policyconfig>
  <vendor>Sora</vendor>
  <vendor_url>https://github.com/levvs-one/sora</vendor_url>
  <action id="io.github.levvs-one.sora.read">
    <description>View the Sora tunnel status</description>
    <description xml:lang="ru">Просмотр состояния туннеля Sora</description>
    <message>Authentication is required to view the Sora tunnel status</message>
    <message xml:lang="ru">Для просмотра состояния туннеля Sora нужна аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:sora</annotate>
  </action>
  <action id="io.github.levvs-one.sora.control">
    <description>Control the Sora tunnel</description>
    <description xml:lang="ru">Управление туннелем Sora</description>
    <message>Authentication is required to control the Sora tunnel</message>
    <message xml:lang="ru">Для управления туннелем Sora нужна аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:sora</annotate>
  </action>
</policyconfig>
