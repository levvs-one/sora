<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sora iOSLegacy app Info.plist (deployment target 13.0).
     Differences from Apps/iOS/Info.plist, all era-driven:
       * UIApplicationSceneManifest DECLARES the scene delegate
         (iOS 13 hosts SwiftUI through AppDelegate/SceneDelegate;
         there is no @main App). XcodeGen fragment for this target
         is listed in TARGET-NOTES.md.
       * URL types and camera usage are identical to the main app.
     Bundle id: proposed in TARGET-NOTES.md §2 (coordinator decides
     the suffix); the value below is that proposal. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sora</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.levvs-one.sora.legacy</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.12</string>
	<key>CFBundleVersion</key>
	<string>13</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Camera is used only by the QR scanner (LegacyQRScannerView). -->
	<key>NSCameraUsageDescription</key>
	<string>Scan a QR code with a server or subscription link.</string>
	<!-- Donated Siri activities (LegacyShortcuts): the activity types
	     Shortcuts/Siri may suggest for this app. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>io.github.levvs-one.sora.action.connect</string>
		<string>io.github.levvs-one.sora.action.disconnect</string>
		<string>io.github.levvs-one.sora.action.status</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.levvs-one.sora.import</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sora</string>
				<string>vless</string>
				<string>vmess</string>
				<string>trojan</string>
				<string>ss</string>
				<string>ssr</string>
				<string>socks</string>
				<string>socks5</string>
				<string>hysteria</string>
				<string>hysteria2</string>
				<string>hy2</string>
				<string>tuic</string>
				<string>wireguard</string>
				<string>wg</string>
				<string>olcrtc</string>
				<string>happ</string>
				<string>hiddify</string>
				<string>streisand</string>
				<string>v2rayn</string>
				<string>v2rayng</string>
				<string>clash</string>
				<string>clashx</string>
				<string>mihomo</string>
				<string>sing-box</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
