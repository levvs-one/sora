<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Widget extension entitlements (draft): read-only use of the shared
     App Group snapshot; no Network Extension entitlement by design. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.levvs-one.sora</string>
	</array>
</dict>
</plist>
