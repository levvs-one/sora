    "updateWaitConnection": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى يصبح اتصال VPN والمركز جاهزًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN bağlantısı və nüvənin hazır olmasını gözləyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пачакайце, пакуль VPN-злучэнне і ядро ​​будуць гатовыя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিপিএন সংযোগ এবং কোর প্রস্তুত হওয়ার জন্য অপেক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis die VPN-Verbindung und der Kern bereit sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the VPN connection and core to become ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere a que la conexión VPN y el núcleo estén listos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منتظر بمانید تا اتصال VPN و هسته آماده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez que la connexion VPN et le noyau soient prêts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीपीएन कनेक्शन और कोर के तैयार होने की प्रतीक्षा करें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասեք, մինչև VPN կապը և միջուկը պատրաստ լինեն:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu hingga koneksi dan inti VPN siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi che la connessione VPN e il core siano pronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 接続とコアの準備が整うまで待ちます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაელოდეთ სანამ VPN კავშირი და ბირთვი მზად იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN қосылымы мен ядросы дайын болғанша күтіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 연결과 코어가 준비될 때까지 기다립니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN туташуусу жана өзөгү даяр болгуча күтө туруңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj, aż połączenie VPN i rdzeń będą gotowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde até que a conexão VPN e o núcleo estejam prontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения подключения и готовности службы Sora."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интизор шавед, ки пайвасти VPN ва аслӣ омода шаванд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอให้การเชื่อมต่อ VPN และคอร์พร้อม"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN birikmesiniň we ýadrosynyň taýýar bolmagyna garaşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN bağlantısının ve çekirdeğin hazır olmasını bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачекайте, поки VPN-з’єднання та ядро ​​будуть готові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN کنکشن اور کور کے تیار ہونے کا انتظار کریں۔"
          }
        },
        "uz": {
