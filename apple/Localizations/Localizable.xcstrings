    "updateNetworkError": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تنزيل التحديث. حاول ثانية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncəlləməni endirmək mümkün olmadı. Yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не атрымалася спампаваць абнаўленне. Паспрабуйце яшчэ раз."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
