        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não terminou. A autenticação pode ter sido cancelada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление не завершилось. Возможно, запрос прав был отменён."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсозӣ ба охир нарасид. Аутентификатсия метавонад бекор карда шавад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตไม่เสร็จสิ้น การรับรองความถูกต้องอาจถูกยกเลิก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Täzelenme gutarmady. Hakyky tanamaklyk ýatyrylan bolmagy mümkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme tamamlanmadı. Kimlik doğrulama iptal edilmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення не завершено. Можливо, автентифікацію скасовано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپ ڈیٹ ختم نہیں ہوا۔ ہو سکتا ہے توثیق منسوخ کر دی گئی ہو۔"
          }
