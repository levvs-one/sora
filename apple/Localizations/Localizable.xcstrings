        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک سرور انتخاب کنید \"سریعترین\" یکی را برای شما انتخاب می کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un serveur. « Le plus rapide » en sélectionne un pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सर्वर चुनें. \"सबसे तेज़\" आपके लिए एक का चयन करता है।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք սերվեր: «Ամենաարագ»-ը ձեզ համար ընտրում է մեկը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih server. “Tercepat” memilih satu untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un server. \"Il più veloce\" ne seleziona uno per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを選択します。 「最速」では、1 つが選択されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ სერვერი. „უსწრაფესი“ ირჩევს ერთს თქვენთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверді таңдаңыз. «Ең жылдам» сіз үшін біреуін таңдайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버를 선택하세요. \"가장 빠름\"이 하나를 선택합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверди тандаңыз. \"Эң ылдам\" сиз үчүн бирин тандайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz serwer. „Najszybszy” wybierze jeden za Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um servidor. “Mais rápido” seleciona um para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сервер. «Самый быстрый» подберёт его за вас."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверро интихоб кунед. \"Зуртарин\" якеро барои шумо интихоб мекунад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเซิร์ฟเวอร์ “เร็วที่สุด” เลือกหนึ่งรายการสำหรับคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer saýlaň. “Iň çalt” siziň üçin birini saýlaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunucu seçin. “En Hızlı” sizin için birini seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть сервер. «Найшвидший» вибере для вас один."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک سرور چنیں۔ \"تیز ترین\" آپ کے لیے ایک کا انتخاب کرتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverni tanlang. “Eng tez” siz uchun birini tanlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một máy chủ. “Nhanh nhất” chọn một cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个服务器。 “最快”为您选择一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個伺服器。 “最快”為您選擇一個。"
          }
        }
      }
    },
    "tourSettings": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات. يمكنك إعادة تشغيل هذا الدليل هناك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrləri açın. Bu təlimatı orada təkrarlaya bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыйце налады. Вы можаце паўтарыць гэта кіраўніцтва там."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস খুলুন। আপনি সেখানে এই নির্দেশিকা পুনরায় চালাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen. Sie können diesen Leitfaden dort noch einmal ansehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open settings. You can replay this guide there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra la configuración. Puedes reproducir esta guía allí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات را باز کنید. می توانید این راهنما را دوباره در آنجا پخش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les paramètres. Vous pouvez y rejouer ce guide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुली सेटिंग। आप वहां इस गाइड को दोबारा चला सकते हैं।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք կարգավորումները: Դուք կարող եք վերարտադրել այս ուղեցույցը այնտեղ:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka pengaturan. Anda dapat memutar ulang panduan ini di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri le impostazioni. Puoi riprodurre questa guida lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開きます。 そこでこのガイドを再生できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით პარამეტრები. თქვენ შეგიძლიათ გაიმეოროთ ეს სახელმძღვანელო იქ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметрлерді ашыңыз. Сіз бұл нұсқаулықты сол жерде қайталай аласыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 엽니다. 여기서 이 가이드를 다시 재생할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөндөөлөрдү ачыңыз. Бул колдонмону ошол жерден кайталай аласыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ustawienia. Możesz tam odtworzyć ten przewodnik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as configurações. Você pode reproduzir este guia lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте настройки. Здесь можно показать гайд снова."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танзимотҳоро кушоед. Шумо метавонед ин дастурро дар он ҷо такрор кунед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่า คุณสามารถเล่นซ้ำคู่มือนี้ได้ที่นั่น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazlamalary açyň. Bu gollanmany şol ýerde gaýtadan ulanyp bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları açın. Bu kılavuzu orada tekrar oynatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте налаштування. Ви можете відтворити цей посібник там."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات کھولیں۔ آپ وہاں اس گائیڈ کو دوبارہ چلا سکتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalarni oching. Siz ushbu qo'llanmani u erda takrorlashingiz mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cài đặt. Bạn có thể phát lại hướng dẫn này ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置。 您可以在那里重播本指南。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開設定。 您可以在那裡重播本指南。"
          }
        }
      }
    },
