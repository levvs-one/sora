    "notificationsEmpty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر أحداث الاتصال والاشتراك هنا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı və abunə hadisələri burada görünəcək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з'явяцца падзеі падключэння і падпіскі"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ এবং সদস্যতা ইভেন্ট এখানে প্রদর্শিত হবে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Verbindungs- und Abonnementereignisse angezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection and subscription events will appear here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos de conexión y suscripción aparecerán aquí"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادهای اتصال و اشتراک در اینجا ظاهر می شوند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements de connexion et d'abonnement apparaîtront ici"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन और सदस्यता ईवेंट यहां दिखाई देंगे"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապի և բաժանորդագրության իրադարձությունները կհայտնվեն այստեղ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa koneksi dan langganan akan muncul di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di connessione e abbonamento verranno visualizzati qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続イベントとサブスクリプション イベントがここに表示されます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირისა და გამოწერის მოვლენები აქ გამოჩნდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосылым және жазылым оқиғалары осы жерде пайда болады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 및 구독 이벤트가 여기에 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Туташуу жана жазылуу окуялары бул жерде көрүнөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się zdarzenia połączenia i subskrypcji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os eventos de conexão e assinatura aparecerão aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся события подключения и подписок"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳодисаҳои пайвастшавӣ ва обуна дар ин ҷо пайдо мешаванд"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมการเชื่อมต่อและการสมัครสมาชิกจะปรากฏที่นี่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baglanyşyk we abuna wakalary şu ýerde peýda bolar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı ve abonelik etkinlikleri burada görünecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут відображатимуться події підключення та підписки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن اور سبسکرپشن ایونٹس یہاں ظاہر ہوں گے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulanish va obuna hodisalari shu yerda paydo bo‘ladi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện kết nối và đăng ký sẽ xuất hiện ở đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接和订阅事件将出现在这里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接和訂閱事件將出現在這裡"
          }
        }
      }
    },
