    "speedtestPageFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الصفحة. أعد تحميله أو افتح الخدمة في متصفح النظام لديك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səhifəni yükləmək mümkün olmadı. Onu yenidən yükləyin və ya xidməti sistem brauzerinizdə açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не атрымалася загрузіць старонку. Перазагрузіце яго або адкрыйце службу ў сістэмным браўзеры."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠাটি লোড করা যায়নি। এটি পুনরায় লোড করুন বা আপনার সিস্টেম ব্রাউজারে পরিষেবাটি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite konnte nicht geladen werden. Laden Sie es neu oder öffnen Sie den Dienst in Ihrem Systembrowser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page could not load. Reload it or open the service in your system browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página no se pudo cargar. Vuelva a cargarlo o abra el servicio en el navegador de su sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه نمی تواند بارگیری شود. آن را دوباره بارگیری کنید یا سرویس را در مرورگر سیستم خود باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page n'a pas pu se charger. Rechargez-le ou ouvrez le service dans le navigateur de votre système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज लोड नहीं हो सका. इसे पुनः लोड करें या अपने सिस्टम ब्राउज़र में सेवा खोलें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էջը չհաջողվեց բեռնել: Վերբեռնեք այն կամ բացեք ծառայությունը ձեր համակարգի բրաուզերում:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman tidak dapat dimuat. Muat ulang atau buka layanan di browser sistem Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la pagina. Ricaricalo o apri il servizio nel browser di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを読み込めませんでした。 リロードするか、システム ブラウザでサービスを開きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გვერდი ვერ ჩაიტვირთა. გადატვირთეთ იგი ან გახსენით სერვისი თქვენი სისტემის ბრაუზერში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бет жүктелмеді. Оны қайта жүктеңіз немесе жүйе шолғышында қызметті ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 로드할 수 없습니다. 다시 로드하거나 시스템 브라우저에서 서비스를 엽니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Барак жүктөлбөй койду. Аны кайра жүктөңүз же системаңыздын браузеринде кызматты ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się załadować strony. Załaduj go ponownie lub otwórz usługę w przeglądarce systemowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A página não pôde carregar. Recarregue-o ou abra o serviço no navegador do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница не загрузилась. Обновите её или откройте сервис в системном браузере."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Саҳифа бор карда нашуд. Онро аз нав бор кунед ё хидматро дар браузери системаи худ кушоед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดหน้านี้ได้ โหลดซ้ำหรือเปิดบริการในเบราว์เซอร์ระบบของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahypa ýükläp bilmedi. Ony täzeden ýükläň ýa-da ulgam brauzeriňizde hyzmaty açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa yüklenemedi. Yeniden yükleyin veya hizmeti sistem tarayıcınızda açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити сторінку. Перезавантажте його або відкрийте службу в системному браузері."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحہ لوڈ نہیں ہو سکا۔ اسے دوبارہ لوڈ کریں یا اپنے سسٹم براؤزر میں سروس کھولیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahifa yuklanmadi. Uni qayta yuklang yoki tizim brauzerida xizmatni oching."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang không thể tải. Tải lại nó hoặc mở dịch vụ trong trình duyệt hệ thống của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面无法加载。 重新加载它或在系统浏览器中打开该服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面無法載入。 重新載入它或在系統瀏覽器中開啟該服務。"
