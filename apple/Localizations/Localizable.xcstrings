            "value": "Mulailah dengan sistem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cominciamo dal sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムから始める"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაიწყეთ სისტემით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүйеден бастаңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템으로 시작하세요"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Системадан баштаңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od systemu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com o sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать вместе с системой"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо система оғоз кунед"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นด้วยระบบ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulgamdan başlaň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemle başlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із системи"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کے ساتھ شروع کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tizimdan boshlang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với hệ thống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从系统入手"
          }
        },
        "zh-Hant": {
