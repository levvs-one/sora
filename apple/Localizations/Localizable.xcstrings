    "bypassLimitations": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز هذا الوضع DPI فقط لـ HTTP وTLS، ولا يدعم UDP أو يغير عنوان IP الخاص بك. استخدم خادم VPN للصوت والمكالمات وعناوين Telegram المحظورة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rejim yalnız HTTP və TLS üçün DPI-dən yan keçir, UDP-ni dəstəkləmir və ya IP-ni dəyişdirmir. Discord səs, zənglər və bloklanmış Telegram ünvanları üçün VPN serverindən istifadə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты рэжым абыходзіць DPI толькі для HTTP і TLS, не падтрымлівае UDP і не змяняе ваш IP. Выкарыстоўвайце сервер VPN для галасавых выклікаў, выклікаў і заблакіраваных адрасоў Telegram."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মোডটি শুধুমাত্র HTTP এবং TLS-এর জন্য DPI বাইপাস করে, UDP সমর্থন করে না বা আপনার IP পরিবর্তন করে না। Discord ভয়েস, কল এবং ব্লক করা Telegram ঠিকানাগুলির জন্য একটি VPN সার্ভার ব্যবহার করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Modus umgeht DPI nur für HTTP und TLS, unterstützt kein UDP und ändert Ihre IP nicht. Verwenden Sie einen VPN-Server für Discord-Sprache, Anrufe und blockierte Telegram-Adressen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mode bypasses DPI only for HTTP and TLS, does not support UDP or change your IP. Use a VPN server for Discord voice, calls and blocked Telegram addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modo omite DPI solo para HTTP y TLS, no admite UDP ni cambia su IP. Utilice un servidor VPN para voz Discord, llamadas y direcciones Telegram bloqueadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این حالت DPI را فقط برای HTTP و TLS دور می‌زند، از UDP پشتیبانی نمی‌کند یا IP شما را تغییر نمی‌دهد. از سرور VPN برای صدای Discord، تماس ها و آدرس های مسدود شده Telegram استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mode contourne le DPI uniquement pour HTTP et TLS, ne prend pas en charge UDP et ne modifie pas votre IP. Utilisez un serveur VPN pour la voix Discord, les appels et les adresses Telegram bloquées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मोड केवल HTTP और TLS के लिए DPI को बायपास करता है, UDP का समर्थन नहीं करता है या आपके IP को नहीं बदलता है। Discord आवाज, कॉल और अवरुद्ध Telegram पतों के लिए वीपीएन सर्वर का उपयोग करें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ռեժիմը շրջանցում է DPI-ն միայն HTTP-ի և TLS-ի համար, չի աջակցում UDP և չի փոխում ձեր IP-ն: Օգտագործեք VPN սերվեր Discord ձայնի, զանգերի և արգելափակված Telegram հասցեների համար:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode ini melewati DPI hanya untuk HTTP dan TLS, tidak mendukung UDP atau mengubah IP Anda. Gunakan server VPN untuk suara Discord, panggilan, dan alamat Telegram yang diblokir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modalità ignora DPI solo per HTTP e TLS, non supporta UDP né modifica il tuo IP. Utilizza un server VPN per voce Discord, chiamate e indirizzi Telegram bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモードは HTTP と TLS に対してのみ DPI をバイパスし、UDP をサポートしたり、IP を変更したりすることはありません。 Discord 音声、通話、およびブロックされた Telegram アドレスには VPN サーバーを使用します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს რეჟიმი გვერდს უვლის DPI-ს მხოლოდ HTTP-სთვის და TLS-ისთვის, არ უჭერს მხარს UDP-ს და არ ცვლის თქვენს IP-ს. გამოიყენეთ VPN სერვერი Discord ხმისთვის, ზარებისთვის და დაბლოკილი Telegram მისამართებისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл режим тек HTTP және TLS үшін DPI мәнін айналып өтеді, UDP қолдамайды немесе IP мекенжайын өзгертпейді. Discord дауыс, қоңыраулар және блокталған Telegram мекенжайлары үшін VPN серверін пайдаланыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모드는 HTTP 및 TLS에 대해서만 DPI를 우회하고 UDP를 지원하지 않으며 IP를 변경하지 않습니다. Discord 음성, 통화 및 차단된 Telegram 주소에 VPN 서버를 사용하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул режим DPI'ди HTTP жана TLS үчүн гана айланып өтөт, UDP'ди колдобойт же IPиңизди өзгөртпөйт. Discord үн, чалуулар жана бөгөттөлгөн Telegram даректери үчүн VPN серверин колдонуңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tryb omija DPI tylko dla HTTP i TLS, nie obsługuje UDP ani nie zmienia adresu IP. Użyj serwera VPN dla głosu, połączeń i zablokowanych adresów Telegram Discord."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modo ignora DPI apenas para HTTP e TLS, não suporta UDP nem altera seu IP. Use um servidor VPN para voz Discord, chamadas e endereços Telegram bloqueados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот режим обходит DPI только для HTTP и TLS, не поддерживает UDP и не меняет IP. Для голоса Discord, звонков и заблокированных адресов Telegram используйте VPN-сервер."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин режим DPI-ро танҳо барои HTTP ва TLS мегузарад, UDP-ро дастгирӣ намекунад ё IP-и шуморо тағир намедиҳад. Барои садои Discord, зангҳо ва суроғаҳои басташудаи Telegram сервери VPN-ро истифода баред."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดนี้จะข้าม DPI สำหรับ HTTP และ TLS เท่านั้น ไม่รองรับ UDP หรือเปลี่ยน IP ของคุณ ใช้เซิร์ฟเวอร์ VPN สำหรับเสียง การโทร และที่อยู่ Telegram ที่ถูกบล็อกของ Discord"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu re DPim diňe HTTP we TLS üçin DPI-den geçýär, UDP-ni goldamaýar ýa-da IP-ni üýtgetmeýär. Discord sesi, jaňlary we bloklanan Telegram salgylary üçin VPN serwerini ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mod DPI'yi yalnızca HTTP ve TLS için atlar, UDP'yi desteklemez veya IP'nizi değiştirmez. Discord sesleri, aramaları ve engellenen Telegram adresleri için bir VPN sunucusu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей режим обходить DPI лише для HTTP та TLS, не підтримує UDP і не змінює ваш IP. Використовуйте сервер VPN для голосу Discord, дзвінків і заблокованих адрес Telegram."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ موڈ صرف HTTP اور TLS کے لیے DPI کو نظرانداز کرتا ہے، نہ UDP کو سپورٹ کرتا ہے اور نہ ہی آپ کے IP کو تبدیل کرتا ہے۔ Discord آواز، کالز اور بلاک شدہ Telegram پتوں کے لیے VPN سرور استعمال کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu rejim faqat HTTP va TLS uchun DPI ni chetlab o'tadi, UDP ni qo'llab-quvvatlamaydi yoki IP-ni o'zgartirmaydi. Discord ovozi, qo'ng'iroqlari va bloklangan Telegram manzillari uchun VPN serveridan foydalaning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ này chỉ bỏ qua DPI cho HTTP và TLS, không hỗ trợ UDP hoặc thay đổi IP của bạn. Sử dụng máy chủ VPN cho cuộc gọi, cuộc gọi và địa chỉ Telegram bị chặn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模式仅针对 HTTP 和 TLS 绕过 DPI，不支持 UDP 或更改您的 IP。 使用 VPN 服务器进行 Discord 语音、呼叫和阻止的 Telegram 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模式僅針對 HTTP 和 TLS 繞過 DPI，不支援 UDP 或變更您的 IP。 使用 VPN 伺服器進行 Discord 語音、呼叫和封鎖的 Telegram 位址。"
          }
        }
      }
    },
