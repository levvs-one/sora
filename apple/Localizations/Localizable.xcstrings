        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อใหม่เพื่อใช้การเปลี่ยนแปลงเหล่านี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu üýtgeşmeleri ulanmak üçin gaýtadan birikdiriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
