    "updateUnsupported": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف القابل للتنفيذ ليس مملوكًا لزوج حزمة Sora المدعوم. استخدم تعليمات تثبيت الإصدار."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu icra olunan fayl dəstəklənən Sora paket cütlüyünə məxsus deyil. Buraxılış quraşdırma təlimatlarından istifadə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты выкананы файл не належыць падтрымоўванай пары пакетаў Sora. Выкарыстоўвайце інструкцыі па ўсталёўцы выпуску."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই এক্সিকিউটেবল একটি সমর্থিত Sora প্যাকেজ জোড়ার মালিকানাধীন নয়। রিলিজ ইনস্টলেশন নির্দেশাবলী ব্যবহার করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausführbare Datei gehört keinem unterstützten Sora-Paketpaar. Verwenden Sie die Installationsanweisungen für das Release."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This executable is not owned by a supported Sora package pair. Use the release installation instructions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ejecutable no pertenece a ningún par de paquetes Sora compatible. Utilice las instrucciones de instalación de la versión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل اجرایی متعلق به یک جفت بسته پشتیبانی شده Sora نیست. از دستورالعمل های نصب نسخه استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exécutable n'appartient pas à une paire de packages Sora prise en charge. Utilisez les instructions d’installation de la version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह निष्पादन योग्य समर्थित Sora पैकेज जोड़ी के स्वामित्व में नहीं है। रिलीज़ इंस्टॉलेशन निर्देशों का उपयोग करें."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործարկիչը չի պատկանում աջակցվող Sora փաթեթի զույգին: Օգտագործեք թողարկման տեղադրման հրահանգները:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksekusi ini tidak dimiliki oleh pasangan paket Sora yang didukung. Gunakan petunjuk instalasi rilis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo eseguibile non è di proprietà di una coppia di pacchetti Sora supportata. Utilizzare le istruzioni di installazione della versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行可能ファイルは、サポートされている Sora パッケージ ペアによって所有されていません。 リリースのインストール手順を使用してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს შესრულებადი არ ეკუთვნის მხარდაჭერილ Sora პაკეტის წყვილს. გამოიყენეთ გამოშვების ინსტალაციის ინსტრუქციები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл орындалатын файл қолдау көрсетілетін Sora бума жұбына тиесілі емес. Шығаруды орнату нұсқауларын пайдаланыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행 파일은 지원되는 Sora 패키지 쌍의 소유가 아닙니다. 릴리스 설치 지침을 사용하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул аткарылуучу файл колдоого алынган Sora пакет жупуна таандык эмес. Чыгарууну орнотуу нускамаларын колдонуңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik wykonywalny nie jest własnością obsługiwanej pary pakietów Sora. Skorzystaj z instrukcji instalacji wersji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este executável não pertence a um par de pacotes Sora compatível. Use as instruções de instalação da versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл приложения не принадлежит поддерживаемой паре пакетов Sora. Используйте инструкцию установки из описания релиза."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин файли иҷрошаванда ба ҷуфти бастаи дастгиришавандаи Sora тааллуқ надорад. Дастурҳои насбкуниро истифода баред."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ปฏิบัติการนี้ไม่ได้เป็นเจ้าของโดยคู่แพ็คเกจ Sora ที่รองรับ ใช้คำแนะนำในการติดตั้งรีลีส"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ýerine ýetirip boljak, goldanýan Sora paket jübütine degişli däl. Goýberiş gurnama görkezmelerini ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yürütülebilir dosya, desteklenen bir Sora paket çiftine ait değil. Sürüm kurulum talimatlarını kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей виконуваний файл не належить підтримуваній парі пакетів Sora. Використовуйте інструкції з встановлення випуску."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ قابل عمل Sora پیکیج جوڑے کی ملکیت نہیں ہے۔ ریلیز کی تنصیب کی ہدایات کا استعمال کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bajariladigan fayl qoʻllab-quvvatlanadigan Sora paketlar juftligiga tegishli emas. Chiqarishni o'rnatish ko'rsatmalaridan foydalaning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp thực thi này không thuộc sở hữu của cặp gói Sora được hỗ trợ. Sử dụng hướng dẫn cài đặt bản phát hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此可执行文件不属于受支持的 Sora 软件包对。 使用发行版安装说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此可執行檔不屬於受支援的 Sora 軟體包對。 使用發行版安裝說明。"
          }
        }
      }
    },
