          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht heruntergeladen werden. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not download the update. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar la actualización. Intentar otra vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آپدیت دانلود نشد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger la mise à jour. Essayer à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट डाउनलोड नहीं हो सका. पुनः प्रयास करें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ներբեռնել թարմացումը: Նորից փորձեք:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengunduh pembaruan. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare l'aggiornamento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをダウンロードできませんでした。 もう一度やり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლების ჩამოტვირთვა ვერ მოხერხდა. სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартуды жүктеп алу мүмкін болмады. Қайтадан байқап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 다운로드할 수 없습니다. 다시 시도해 보세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртуу жүктөлүп алынбай койду. Кайра аракет кыл."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można pobrać aktualizacji. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar a atualização. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скачать обновление. Попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсозӣ зеркашӣ карда нашуд. Як бори дигар санҷед."
