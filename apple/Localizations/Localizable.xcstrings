          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana sunucu tekrar cevap verir ve trafiği taşır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Головний сервер знову відповідає і переносить трафік"
