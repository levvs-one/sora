    "noticeMainBack": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجيب الخادم الرئيسي مرة أخرى ويحمل حركة المرور"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas server yenidən cavab verir və trafiki daşıyır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Галоўны сервер зноў адказвае і пераносіць трафік"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধান সার্ভার আবার উত্তর দেয় এবং ট্রাফিক বহন করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptserver antwortet erneut und leitet den Datenverkehr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main server answers again and carries the traffic"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor principal responde nuevamente y transporta el tráfico."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور اصلی دوباره پاسخ می دهد و ترافیک را حمل می کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur principal répond à nouveau et achemine le trafic"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य सर्वर फिर से उत्तर देता है और ट्रैफ़िक ले जाता है"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական սերվերը կրկին պատասխանում է և տեղափոխում է տրաֆիկը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server utama menjawab lagi dan membawa lalu lintas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server principale risponde di nuovo e trasporta il traffico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインサーバーが再度応答し、トラフィックを伝送します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარი სერვერი ისევ პასუხობს და ახორციელებს ტრაფიკს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі сервер қайтадан жауап береді және трафикті тасымалдайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 서버가 다시 응답하고 트래픽을 전달합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги сервер кайра жооп берип, трафикти алып барат"
