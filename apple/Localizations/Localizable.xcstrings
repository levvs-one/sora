    "leakTestIntro": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Probes whether traffic can leave the device outside the tunnel: direct DNS and ICMP, IPv6 egress, and the system resolvers. Run it while connected."
