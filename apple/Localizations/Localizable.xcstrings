    "tourServer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خادمًا. \"الأسرع\" يختار واحدًا لك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir server seçin. “Ən sürətli” sizin üçün birini seçir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце сервер. «Самы хуткі» выбірае для вас адзін."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সার্ভার চয়ন করুন। \"দ্রুততম\" আপনার জন্য একটি নির্বাচন করে।"
          }
