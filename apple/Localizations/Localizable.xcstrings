    "tourMode": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الوضع. يقوم Kill Switch بحظر الإنترنت في حالة انقطاع VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rejim seçin. VPN düşərsə, keçid bloklarını öldürün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце рэжым. Kill Switch блакуе Інтэрнэт, калі VPN падае."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মোড চয়ন করুন. VPN কমে গেলে কিল সুইচ ইন্টারনেট ব্লক করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Modus. Der Kill-Switch blockiert das Internet, wenn das VPN ausfällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a mode. Kill switch blocks internet if the VPN drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modo. Kill Switch bloquea Internet si la VPN se cae."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک حالت را انتخاب کنید. در صورت قطع شدن VPN، سوئیچ Kill اینترنت را مسدود می کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mode. Kill Switch bloque Internet si le VPN tombe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मोड चुनें. यदि वीपीएन बंद हो जाए तो किल स्विच इंटरनेट को ब्लॉक कर देता है।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք ռեժիմ: Kill switch-ը արգելափակում է ինտերնետը, եթե VPN-ն ընկնի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih mode. Tombol pemutus memblokir internet jika VPN terputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una modalità. Il kill switch blocca Internet se la VPN si interrompe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードを選択します。 VPN が切断された場合、キルスイッチはインターネットをブロックします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ რეჟიმი. Kill switch ბლოკავს ინტერნეტს, თუ VPN ჩამოვარდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимді таңдаңыз. VPN өшірілсе, коммутаторды өшіріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드를 선택하세요. VPN이 끊어지면 킬 스위치가 인터넷을 차단합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимди тандаңыз. VPN түшүп калса, өчүрүү блокторун өлтүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tryb. Przełącznik Kill blokuje Internet, jeśli VPN spadnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um modo. Kill switch bloqueia a Internet se a VPN cair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите режим. Kill switch блокирует интернет при обрыве VPN."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимро интихоб кунед. Агар VPN афтад, коммутаторро блокҳои интернетро кушед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโหมด Kill switch จะบล็อกอินเทอร์เน็ตหาก VPN หลุด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Re modeimi saýlaň. VPN düşse, wyklýuçatel interneti bloklaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir mod seçin. VPN düşerse Kill Switch interneti engeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть режим. Kill Switch блокує Інтернет, якщо VPN переривається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک موڈ کا انتخاب کریں۔ VPN گرنے پر Kill سوئچ انٹرنیٹ کو بلاک کر دیتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartibni tanlang. Agar VPN tushib qolsa, o'chirish kaliti internetni bloklaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một chế độ. Kill switch chặn internet nếu VPN bị rớt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种模式。 如果 VPN 掉线，终止开关会阻止互联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一種模式。 如果 VPN 斷線，終止開關會阻止網路。"
          }
        }
      }
    },
