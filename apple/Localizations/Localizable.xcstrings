    "diagnosticNoData": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد طلبات مسجلة حتى الآن. افتح موقع اختبار السرعة أولاً."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ qeydə alınmış sorğu yoxdur. Əvvəlcə sürət testi veb saytını açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма запісаных запытаў. Спачатку адкрыйце вэб-сайт для праверкі хуткасці."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোন রেকর্ড করা অনুরোধ. প্রথমে একটি গতি পরীক্ষার ওয়েবসাইট খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine erfassten Anfragen. Öffnen Sie zunächst eine Website für Geschwindigkeitstests."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recorded requests yet. Open a speed test website first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay solicitudes registradas. Primero abra un sitio web de prueba de velocidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز درخواستی ثبت نشده است. ابتدا یک وب سایت تست سرعت باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune demande enregistrée pour l'instant. Ouvrez d’abord un site Web de test de vitesse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई रिकॉर्डेड अनुरोध नहीं. सबसे पहले एक स्पीड टेस्ट वेबसाइट खोलें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռևս գրանցված հարցումներ չկան: Սկզբում բացեք արագության թեստավորման կայք:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada permintaan yang tercatat. Buka situs tes kecepatan terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna richiesta registrata ancora. Apri prima un sito Web di test di velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されたリクエストはまだありません。 まずスピードテストのWebサイトを開きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არ არის ჩაწერილი მოთხოვნა. ჯერ გახსენით სიჩქარის ტესტის ვებსაიტი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылған сұраулар әлі жоқ. Алдымен жылдамдықты тексеру веб-сайтын ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기록된 요청이 없습니다. 먼저 속도 테스트 웹사이트를 열어보세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылган сурамдар азырынча жок. Адегенде ылдамдыкты текшерүү вебсайтын ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze zarejestrowanych żądań. Najpierw otwórz witrynę z testami prędkości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma solicitação registrada ainda. Abra primeiro um site de teste de velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросов пока нет. Сначала откройте сайт проверки скорости."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон дархост сабт нашудааст. Аввал вебсайти санҷиши суръатро кушоед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการร้องขอที่บันทึกไว้ เปิดเว็บไซต์ทดสอบความเร็วก่อน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Entek ýazylan haýyş ýok. Ilki bilen tizlik synag web sahypasyny açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıtlı istek yok. Önce bir hız testi web sitesi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає записаних запитів. Спочатку відкрийте сайт тесту швидкості."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی ریکارڈ شدہ درخواستیں نہیں ہیں۔ پہلے اسپیڈ ٹیسٹ کی ویب سائٹ کھولیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha hech qanday soʻrov qayd etilmagan. Avval tezlikni tekshirish veb-saytini oching."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có yêu cầu nào được ghi lại. Trước tiên hãy mở một trang web kiểm tra tốc độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未记录请求。 首先打开一个速度测试网站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未記錄請求。 首先打開一個速度測試網站。"
          }
        }
      }
    },
