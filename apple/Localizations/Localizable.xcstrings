          "stringUnit": {
            "state": "translated",
            "value": "এই পরিবর্তনগুলি প্রয়োগ করতে পুনরায় সংযোগ করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die Verbindung erneut her, um diese Änderungen zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to apply these changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a conectarse para aplicar estos cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اعمال این تغییرات دوباره وصل شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour appliquer ces modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन परिवर्तनों को लागू करने के लिए पुनः कनेक्ट करें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս փոփոխությունները կիրառելու համար նորից միացեք:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan kembali untuk menerapkan perubahan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti per applicare queste modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの変更を適用するには、再接続してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელახლა დაუკავშირდით ამ ცვლილებების გამოსაყენებლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өзгертулерді қолдану үшін қайта қосылыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
