    "errRestore": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكن عملية تنظيف الاتصال كاملة. أعد محاولة قطع الاتصال؛ راجع السجل للحصول على التفاصيل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantının təmizlənməsi tamamlanmadı. Bağlantını kəsməyə yenidən cəhd edin; təfərrüatlar üçün jurnala baxın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ачыстка злучэння была няпоўная. Паўтарыць адключэнне; падрабязнасці глядзіце ў журнале."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ পরিষ্কার অসম্পূর্ণ ছিল. সংযোগ বিচ্ছিন্ন করার পুনরায় চেষ্টা করুন; বিস্তারিত জানার জন্য লগ দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsbereinigung war unvollständig. Versuchen Sie erneut, die Verbindung zu trennen. Einzelheiten finden Sie im Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection cleanup was incomplete. Retry disconnecting; see the log for details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza de la conexión fue incompleta. Vuelva a intentar desconectarse; consulte el registro para obtener más detalles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاکسازی اتصال ناقص بود. قطع ارتباط مجدد را امتحان کنید. برای جزئیات به لاگ مراجعه کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la connexion était incomplet. Réessayez de vous déconnecter ; voir le journal pour plus de détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन सफ़ाई अधूरी थी. डिस्कनेक्ट करने का पुनः प्रयास करें; विवरण के लिए लॉग देखें."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապի մաքրումը թերի էր: Կրկին փորձեք անջատել; մանրամասների համար տես գրանցամատյանը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan koneksi tidak lengkap. Coba lagi memutuskan sambungan; lihat log untuk detailnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia della connessione era incompleta. Riprovare a disconnettersi; vedere il registro per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続のクリーンアップが不完全でした。 切断を再試行してください。 詳細についてはログを参照してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირის გასუფთავება არასრული იყო. ხელახლა სცადეთ გათიშვა; იხილეთ ჟურნალი დეტალებისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Байланысты тазалау аяқталмады. Ажыратуды қайталап көріңіз; мәліметтер алу үшін журналды қараңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정리가 완료되지 않았습니다. 연결 해제를 다시 시도하세요. 자세한 내용은 로그를 참조하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Туташуу тазаланбай калды. Кайра ажыратып көрүңүз; чоо-жайын билүү үчүн журналды карагыла."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie połączenia było niekompletne. Spróbuj ponownie rozłączyć; szczegóły znajdziesz w logu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza da conexão estava incompleta. Tente desconectar novamente; veja o log para detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось полностью очистить подключение. Повторите отключение; подробности — в журнале."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тозакунии пайвастшавӣ нопурра буд. Кӯшиш кунед, ки пайвастшавиро қатъ кунед; барои тафсилот ба гузориш нигаред."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างข้อมูลการเชื่อมต่อไม่สมบูรณ์ ลองยกเลิกการเชื่อมต่ออีกครั้ง ดูบันทึกเพื่อดูรายละเอียด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baglanyşygy arassalamak doly däldi. Aýyrmak üçin gaýtadan synanyşyň; jikme-jiklikler üçin gündelige serediň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı temizliği tamamlanmadı. Bağlantıyı kesmeyi yeniden deneyin; ayrıntılar için günlüğe bakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищення підключення не завершено. Повторити відключення; подробиці дивіться в журналі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن کی صفائی نامکمل تھی۔ منقطع کرنے کی دوبارہ کوشش کریں؛ تفصیلات کے لیے لاگ دیکھیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulanishni tozalash tugallanmadi. Ulanishni qaytadan urinish; tafsilotlar uchun jurnalga qarang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc dọn dẹp kết nối chưa hoàn tất. Thử ngắt kết nối lại; xem nhật ký để biết chi tiết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接清理不完整。 重试断开连接； 详细信息请参阅日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線清理不完整。 重試斷開連線；詳細資訊請參閱日誌。"
          }
        }
      }
    },
