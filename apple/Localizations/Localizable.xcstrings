          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул өзгөртүүлөрдү колдонуу үчүн кайра туташыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się ponownie, aby zastosować te zmiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte-se para aplicar essas alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы применить изменения, переподключитесь."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои татбиқи ин тағйирот дубора пайваст шавед."
