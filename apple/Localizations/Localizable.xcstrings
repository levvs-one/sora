    "alert.configBuildFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora could not build a configuration from the selected server. The server was not changed; try another one or re-import it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora не смогла собрать конфигурацию из выбранного сервера. Сервер не изменён; попробуйте другой или импортируйте его заново."
          }
        }
      }
    },
    "alert.importFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed. The text was not recognized as a server, subscription or config; nothing was added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт не удался. Текст не распознан как сервер, подписка или конфигурация; ничего не добавлено."
          }
        }
      }
    },
    "alert.noProfileSelected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server is selected. Pick a server first, then connect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не выбран. Сначала выберите сервер, затем подключайтесь."
          }
        }
      }
    },
    "alert.profileStoreFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora could not save to the profile storage. Your existing profiles were not modified."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
