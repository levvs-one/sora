    "errBusy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر، الأمر السابق لا يزال قيد التشغيل"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözləyin, əvvəlki əmr hələ də işləyir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пачакайце, папярэдняя каманда ўсё яшчэ выконваецца"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষা করুন, আগের কমান্ডটি এখনও চলছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, der vorherige Befehl wird noch ausgeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait, the previous command is still running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera, el comando anterior todavía se está ejecutando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صبر کنید، دستور قبلی همچنان در حال اجرا است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez, la commande précédente est toujours en cours d'exécution"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुको, पिछला आदेश अभी भी चल रहा है"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասեք, նախորդ հրամանը դեռ աշխատում է"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu, perintah sebelumnya masih berjalan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta, il comando precedente è ancora in esecuzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ってください、前のコマンドはまだ実行中です"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაელოდეთ, წინა ბრძანება ჯერ კიდევ მუშაობს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күте тұрыңыз, алдыңғы пәрмен әлі жұмыс істейді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐, 이전 명령이 아직 실행 중입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтө туруңуз, мурунку буйрук дагы эле иштеп жатат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekaj, poprzednie polecenie nadal działa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere, o comando anterior ainda está em execução"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите, предыдущая команда ещё выполняется"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интизор шавед, фармони қаблӣ ҳоло ҳам иҷро мешавад"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอสักครู่ คำสั่งก่อนหน้ายังคงทำงานอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Duruň, öňki buýruk henizem işleýär"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekle, önceki komut hala çalışıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачекайте, попередня команда все ще виконується"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
