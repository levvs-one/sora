    "updateReleaseError": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الإصدار أو الملفات المطلوبة مفقودة أو غير صالحة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraxılış məlumatları və ya tələb olunan fayllar yoxdur və ya etibarsızdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя выпуску або неабходныя файлы адсутнічаюць або несапраўдныя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিলিজ ডেটা বা প্রয়োজনীয় ফাইলগুলি অনুপস্থিত বা অবৈধ৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Release-Daten oder erforderlichen Dateien fehlen oder sind ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release data or required files are missing or invalid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de publicación o los archivos requeridos faltan o no son válidos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های انتشار یا فایل‌های مورد نیاز وجود ندارد یا نامعتبر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de version ou les fichiers requis sont manquants ou invalides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ डेटा या आवश्यक फ़ाइलें गुम या अमान्य हैं।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թողարկման տվյալները կամ պահանջվող ֆայլերը բացակայում են կամ անվավեր են:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data rilis atau file yang diperlukan hilang atau tidak valid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di rilascio o i file richiesti mancano o non sono validi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリース データまたは必要なファイルが欠落しているか無効です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოშვების მონაცემები ან საჭირო ფაილები აკლია ან არასწორია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығарылым деректері немесе қажетті файлдар жоқ немесе жарамсыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스 데이터 또는 필수 파일이 누락되었거나 잘못되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгарылган маалыматтар же талап кылынган файлдар жок же жараксыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje danych wersji lub wymaganych plików lub są one nieprawidłowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de lançamento ou arquivos necessários estão ausentes ou são inválidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные релиза или нужные файлы отсутствуют либо некорректны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти релиз ё файлҳои зарурӣ нест ё беэътибор аст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลการเผยแพร่หรือไฟล์ที่จำเป็นหายไปหรือไม่ถูกต้อง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Goýberilýän maglumatlar ýa-da zerur faýllar ýok ýa-da nädogry."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm verileri veya gerekli dosyalar eksik veya geçersiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані випуску або необхідні файли відсутні або недійсні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریلیز ڈیٹا یا مطلوبہ فائلیں غائب یا غلط ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiqarish ma'lumotlari yoki kerakli fayllar etishmayotgan yoki yaroqsiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu phát hành hoặc các tệp được yêu cầu bị thiếu hoặc không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布数据或所需文件丢失或无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發布資料或所需文件遺失或無效。"
          }
        }
      }
    },
