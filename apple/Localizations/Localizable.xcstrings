    "state.appGroupUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared app group is unavailable, so the app and the tunnel extension cannot exchange settings. Reinstalling Sora usually fixes this; your subscriptions are kept in the backup export."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая группа приложений недоступна, поэтому приложение и расширение туннеля не могут обмениваться настройками. Обычно помогает переустановка Sora; подписки сохраните через экспорт резерва."
          }
        }
      }
    },
    "state.autoLaunchUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is not available on this system version. Sora can still be opened manually; no setting was changed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозапуск при входе недоступен на этой версии системы. Sora можно открывать вручную; никакие настройки не изменены."
          }
        }
      }
    },
    "state.captivePortalDetected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Wi-Fi seems to require signing in through a web page. Connect to the portal first, then start Sora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, эта сеть Wi-Fi требует входа через веб-страницу. Сначала войдите на портале, затем запустите Sora."
          }
        }
      }
    },
    "state.connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено"
          }
        }
      }
    },
    "state.connecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение…"
          }
        }
      }
    },
    "state.disconnected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подключено"
          }
        }
      }
    },
    "state.disconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение…"
          }
        }
      }
    },
    "state.emptyStateActionHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet. Use the button above to add the first one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь пока пусто. Нажмите кнопку выше, чтобы добавить первый."
          }
        }
      }
    },
    "state.extensionFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension reported a problem. Details are in Logs; try reconnecting, and approve any pending request in System Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое расширение сообщило о проблеме. Подробности — в «Журнале»; попробуйте переподключиться и одобрите ожидающий запрос в «Системных настройках», если он есть."
          }
        }
      }
    },
    "state.extensionInstallFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension could not be installed. Check System Settings for a pending approval and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить сетевое расширение. Проверьте в «Системных настройках» ожидающее одобрение и попробуйте снова."
          }
        }
      }
    },
    "state.extensionMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not include the network extension, so the tunnel cannot start. Install an official Sora build."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке нет сетевого расширения, поэтому туннель не запустится. Установите официальную сборку Sora."
          }
        }
      }
    },
    "state.extensionNeedsRestart": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension was updated and needs a restart. Restart Sora (on macOS a reboot may be required) and reconnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое расширение обновилось и требует перезапуска. Перезапустите Sora (на macOS может потребоваться перезагрузка) и переподключитесь."
          }
        }
      }
    },
    "state.extensionNotApproved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sora network extension is not approved. Approve it in System Settings, then reconnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое расширение Sora не одобрено. Одобрите его в «Системных настройках», затем переподключитесь."
          }
        }
      }
    },
    "state.extensionUpdatePendingApproval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An updated network extension is waiting for approval. Until it is approved, the previous version keeps working or the tunnel stays off — it is never silently replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлённое сетевое расширение ждёт одобрения. Пока оно не одобрено, работает прежняя версия или туннель остаётся выключен — подмены без вашего ведома не происходит."
          }
        }
      }
    },
    "state.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed. Details are in Logs — Sora never shows raw system errors here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось. Подробности — в «Журнале»; сырые системные ошибки Sora здесь не показывает."
          }
        }
      }
    },
    "state.intentNeedsAppApproval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut needs the VPN profile to be approved in Sora first. Open Sora once and finish setup, then run the shortcut again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой быстрой команде сначала нужно одобрение VPN-профиля в Sora. Откройте Sora один раз и завершите настройку, затем запустите команду снова."
          }
        }
      }
    },
    "state.ipv6UnavailableOnNetwork": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv6 is not available on this network. Sora continues over IPv4 and blocks IPv6 leaks instead of sending traffic outside the tunnel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv6 недоступен в этой сети. Sora продолжает работу по IPv4 и блокирует утечки IPv6, а не отправляет трафик мимо туннеля."
          }
        }
      }
    },
    "state.keychainUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system keychain is unavailable right now. Secrets stay stored and are not written anywhere less safe; try again after unlocking the device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная связка ключей сейчас недоступна. Секреты остаются на месте и не записываются в менее безопасное место; попробуйте снова после разблокировки устройства."
          }
        }
      }
    },
    "state.killSwitchNeedsExtension": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill switch needs the approved network extension. Without it Sora will not pretend traffic is blocked while disconnected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill switch требует одобренного сетевого расширения. Без него Sora не будет делать вид, что трафик заблокирован при отключении."
          }
        }
      }
    },
    "state.networkChangedOffline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new network has no internet connection yet. Sora will reconnect automatically when it appears."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В новой сети пока нет интернета. Sora переподключится автоматически, как только он появится."
          }
        }
      }
    },
    "state.profileNotCreated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No VPN profile yet. Tap Connect and allow Sora to add a VPN configuration."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-профиль ещё не создан. Нажмите «Подключить» и разрешите Sora добавить VPN-конфигурацию."
          }
        }
      }
    },
    "state.reconnectDelayedLowPower": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode is delaying reconnection. Sora will reconnect as soon as the system allows background work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим энергосбережения задерживает переподключение. Sora переподключится, как только система разрешит фоновую работу."
          }
        }
      }
    },
    "state.reconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переподключение…"
          }
        }
      }
    },
    "state.reconnectingAfterNetworkChange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network changed — reconnecting to the same server…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть изменилась — переподключаюсь к тому же серверу…"
          }
        }
      }
    },
    "state.tunnelStoppedBySystem": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system stopped the tunnel (for example after an update or a memory limit). Tap Connect to start it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система остановила туннель (например, после обновления или из-за лимита памяти). Нажмите «Подключить», чтобы запустить его снова."
          }
        }
      }
    },
    "state.tunnelUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel is unavailable in this build (the provider framework is not linked). Install an official Sora build."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель недоступен в этой сборке (фреймворк провайдера не подключён). Установите официальную сборку Sora."
          }
        }
      }
    },
    "state.vpnProfileApprovalPathIos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS: Settings → General → VPN & Device Management → Sora → Allow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iOS: «Настройки» → «Основные» → «VPN и управление устройством» → Sora → «Разрешить»."
          }
        }
      }
    },
    "state.vpnProfileApprovalPathMac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS: System Settings → General → Login Items & Extensions (or Network → VPN) and approve Sora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На macOS: «Системные настройки» → «Основные» → «Объекты входа и расширения» (или «Сеть» → VPN) и одобрите Sora."
          }
        }
      }
    },
    "state.vpnProfileMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No VPN profile yet. Add a server or subscription, then tap Connect — Sora will ask to create the profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-профиля пока нет. Добавьте сервер или подписку и нажмите «Подключить» — Sora предложит создать профиль."
          }
        }
      }
    },
    "state.vpnProfileNotApproved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profile not approved yet. Open Settings and allow Sora to add a VPN configuration, then try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-профиль ещё не одобрен. Откройте «Настройки» и разрешите Sora добавить VPN-конфигурацию, затем попробуйте снова."
          }
        }
      }
    },
    "state.widgetStaleData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget shows the last known state because the tunnel has not reported since. Open Sora to refresh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет показывает последнее известное состояние, потому что туннель давно не сообщал данные. Откройте Sora, чтобы обновить."
          }
        }
      }
    },
