        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლება არ დასრულებულა. ავთენტიფიკაცია შეიძლება გაუქმდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңарту аяқталмады. Аутентификация жойылған болуы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 완료되지 않았습니다. 인증이 취소되었을 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртуу аягына чыккан жок. Аутентификация жокко чыгарылган болушу мүмкүн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja nie została zakończona. Uwierzytelnianie mogło zostać anulowane."
          }
