    "launchAtLoginDetail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ Sora تلقائيًا عند تسجيل الدخول ويبقى في علبة النظام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxil olduqda Sora avtomatik işə düşəcək və nimçədə qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora аўтаматычна запускаецца пры ўваходзе ў сістэму і застаецца ў трэі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইন করলে Sora স্বয়ংক্রিয়ভাবে চালু হবে এবং ট্রেতে থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora wird beim Anmelden automatisch gestartet und bleibt im Infobereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora will launch automatically when you sign in, hidden in the tray."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora se iniciará automáticamente al iniciar sesión y quedará en la bandeja del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora هنگام ورود به سیستم به‌طور خودکار اجرا می‌شود و در سینی سیستم باقی می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora démarrera automatiquement à la connexion, en arrière-plan dans la barre d'état."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने पर Sora अपने आप शुरू होगा और ट्रे में रहेगा।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործելիս Sora-ն կգործարկվի ավտոմատ և կմնա համակարգային սկուտեղում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora akan berjalan otomatis saat Anda masuk dan tetap berada di tray."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora si avvierà automaticamente all'accesso e resterà nell'area di notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン時に Sora が自動的に起動し、トレイに常駐します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესვლისას Sora ავტომატურად გაეშვება და დარჩება სისტემურ უჯრაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүйеге кіргенде Sora автоматты түрде іске қосылып, науада қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 Sora가 자동으로 시작되어 트레이에 상주합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Системага киргенде Sora автоматтык түрдө ишке кирип, лотокто калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora będzie automatycznie uruchamiana przy logowaniu i pozostanie w zasobniku systemowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sora será iniciado automaticamente ao entrar e ficará na bandeja do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora будет автоматически запускаться при входе в систему и оставаться в трее."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми воридшавӣ ба система Sora ба таври худкор оғоз шуда, дар tray мемонад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora จะเริ่มทำงานอัตโนมัติเมื่อคุณเข้าสู่ระบบและอยู่ในถาดระบบ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulgama gireniňizde Sora awtomatiki işe girizer we lotoqda galar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açtığınızda Sora otomatik olarak başlatılacak ve tepside kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora автоматично запускатиметься під час входу в систему й залишатиметься в треї."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کرنے پر Sora خودکار طور پر شروع ہوگا اور ٹرے میں رہے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tizimga kirganingizda Sora avtomatik ishga tushadi va laganda qoladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora sẽ tự động khởi động khi bạn đăng nhập và nằm ở khay hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时 Sora 会自动启动，并隐藏到系统托盘中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時 Sora 會自動啟動，並隱藏到系統托盤中。"
          }
        }
      }
    },
