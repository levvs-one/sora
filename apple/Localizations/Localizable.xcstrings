    "updateManual": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل هذا الأمر في الوحدة الطرفية لتثبيت الحزمتين اللتين تم التحقق منهما، ثم أعد فتح Sora. تبقى الملفات في دليل التنزيل. سينقطع اتصال VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iki təsdiqlənmiş paketi quraşdırmaq üçün bu əmri terminalda işə salın, sonra Sora-i yenidən açın. Fayllar yükləmə qovluğunda qalır. VPN bağlantısı kəsiləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запусціце гэту каманду ў тэрмінале, каб усталяваць абодва правераныя пакеты, затым зноў адкрыйце Sora. Файлы застаюцца ў каталогу загрузкі. VPN-злучэнне абарвецца."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উভয় যাচাইকৃত প্যাকেজ ইনস্টল করতে একটি টার্মিনালে এই কমান্ডটি চালান, তারপর Sora পুনরায় খুলুন। ফাইলগুলি ডাউনলোড ডিরেক্টরিতে থাকে। ভিপিএন কানেকশন বন্ধ হয়ে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie diesen Befehl in einem Terminal aus, um beide verifizierten Pakete zu installieren, und öffnen Sie dann Sora erneut. Die Dateien bleiben im Download-Verzeichnis. Die VPN-Verbindung wird unterbrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run this command in a terminal to install both verified packages, then reopen Sora. The files stay in the download directory. The VPN connection will drop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecute este comando en una terminal para instalar ambos paquetes verificados y luego vuelva a abrir Sora. Los archivos permanecen en el directorio de descarga. La conexión VPN se cortará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستور را در ترمینال اجرا کنید تا هر دو بسته تایید شده نصب شوند، سپس Sora را دوباره باز کنید. فایل ها در دایرکتوری دانلود می مانند. اتصال VPN قطع می شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez cette commande dans un terminal pour installer les deux packages vérifiés, puis rouvrez Sora. Les fichiers restent dans le répertoire de téléchargement. La connexion VPN sera interrompue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों सत्यापित पैकेजों को स्थापित करने के लिए इस कमांड को टर्मिनल में चलाएँ, फिर Sora को फिर से खोलें। फ़ाइलें डाउनलोड निर्देशिका में रहती हैं। वीपीएन कनेक्शन बंद हो जाएगा."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարկեք այս հրամանը տերմինալում՝ երկու ստուգված փաթեթները տեղադրելու համար, այնուհետև նորից բացեք Sora: Ֆայլերը մնում են ներբեռնման գրացուցակում: VPN կապը կդադարի:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan perintah ini di terminal untuk menginstal kedua paket terverifikasi, lalu buka kembali Sora. File-file tersebut tetap berada di direktori unduhan. Koneksi VPN akan terputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui questo comando in un terminale per installare entrambi i pacchetti verificati, quindi riapri Sora. I file rimangono nella directory di download. La connessione VPN verrà interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルでこのコマンドを実行して両方の検証済みパッケージをインストールし、Sora を再度開きます。 ファイルはダウンロード ディレクトリに残ります。 VPN 接続が切断されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაუშვით ეს ბრძანება ტერმინალში ორივე დამოწმებული პაკეტის დასაყენებლად, შემდეგ ხელახლა გახსენით Sora. ფაილები რჩება ჩამოტვირთვის დირექტორიაში. VPN კავშირი შეწყდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексерілген екі буманы орнату үшін осы пәрменді терминалда іске қосыңыз, содан кейін Sora қайта ашыңыз. Файлдар жүктеп алу каталогында қалады. VPN байланысы үзіледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 이 명령을 실행하여 확인된 두 패키지를 모두 설치한 다음 Sora를 다시 엽니다. 파일은 다운로드 디렉터리에 유지됩니다. VPN 연결이 끊어집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Текшерилген эки пакетти тең орнотуу үчүн бул буйрукту терминалда иштетиңиз, андан кийин Soraди кайра ачыңыз. Файлдар жүктөө каталогунда калат. VPN байланышы үзүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom to polecenie w terminalu, aby zainstalować oba zweryfikowane pakiety, a następnie otwórz ponownie Sora. Pliki pozostają w katalogu pobierania. Połączenie VPN zostanie zerwane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute este comando em um terminal para instalar os dois pacotes verificados e reabra Sora. Os arquivos ficam no diretório de download. A conexão VPN cairá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните команду в терминале для установки обоих проверенных пакетов, затем откройте Sora снова. Файлы сохранены в каталоге загрузки. VPN-соединение прервётся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин фармонро дар терминал иҷро кунед, то ҳарду бастаи тасдиқшударо насб кунед, пас Sora-ро аз нав кушоед. Файлҳо дар директорияи зеркашӣ мемонанд. Пайвасти VPN қатъ мешавад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกใช้คำสั่งนี้ในเทอร์มินัลเพื่อติดตั้งแพ็คเกจที่ตรวจสอบแล้วทั้งสองรายการ จากนั้นเปิด Sora อีกครั้ง ไฟล์จะยังคงอยู่ในไดเร็กทอรีดาวน์โหลด การเชื่อมต่อ VPN จะลดลง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Barlanylan paketleri gurmak üçin bu buýrugy terminalda işlediň, soňra Sora açyň. Faýllar göçürip almak katalogynda galýarlar. VPN birikmesi peseler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki doğrulanmış paketi de yüklemek için bu komutu bir terminalde çalıştırın, ardından Sora'yi yeniden açın. Dosyalar indirme dizininde kalır. VPN bağlantısı kesilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте цю команду в терміналі, щоб інсталювати обидва перевірені пакети, а потім повторно відкрийте Sora. Файли залишаються в каталозі завантаження. З’єднання VPN припиниться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں تصدیق شدہ پیکیجز کو انسٹال کرنے کے لیے اس کمانڈ کو ٹرمینل میں چلائیں، پھر Sora کو دوبارہ کھولیں۔ فائلیں ڈاؤن لوڈ ڈائرکٹری میں رہتی ہیں۔ VPN کنکشن ختم ہو جائے گا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikkala tasdiqlangan paketni o'rnatish uchun ushbu buyruqni terminalda ishga tushiring, so'ngra Sora ni qayta oching. Fayllar yuklab olish katalogida qoladi. VPN ulanishi uziladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy lệnh này trong thiết bị đầu cuối để cài đặt cả hai gói đã được xác minh, sau đó mở lại Sora. Các tập tin vẫn ở trong thư mục tải xuống. Kết nối VPN sẽ bị rớt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中运行此命令以安装两个经过验证的软件包，然后重新打开 Sora。 文件保留在下载目录中。 VPN 连接将会断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機中執行此命令以安裝兩個經過驗證的軟體包，然後重新開啟 Sora。 檔案保留在下載目錄中。 VPN 連線將會中斷。"
          }
        }
      }
    },
