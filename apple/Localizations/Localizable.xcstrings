    "noticeBackup": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم الرئيسي لم يرد؛ النسخ الاحتياطي يحمل حركة المرور"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas server cavab vermədi; ehtiyat trafiki daşıyır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Галоўны сервер не адказваў; рэзервовая копія пераносіць трафік"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধান সার্ভার উত্তর দেয়নি; ব্যাকআপ ট্রাফিক বহন করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptserver antwortete nicht; Das Backup überträgt den Datenverkehr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main server didn't answer; the backup carries the traffic"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor principal no respondió; la copia de seguridad lleva el tráfico"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور اصلی جواب نداد. پشتیبان گیری ترافیک را حمل می کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur principal n'a pas répondu ; la sauvegarde transporte le trafic"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य सर्वर ने उत्तर नहीं दिया; बैकअप ट्रैफ़िक को वहन करता है"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական սերվերը չպատասխանեց. կրկնօրինակն իրականացնում է երթևեկությունը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server utama tidak menjawab; cadangan membawa lalu lintas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server principale non ha risposto; il backup trasporta il traffico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインサーバーは応答しませんでした。 バックアップはトラフィックを伝送します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარმა სერვერმა არ უპასუხა; სარეზერვო ახორციელებს ტრაფიკს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
