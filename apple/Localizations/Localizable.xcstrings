    "controlPortQuestion": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التحكم في %@ من خلال منفذ موجود على هذا الكمبيوتر. ستكون البرامج الأخرى قادرة على معرفة أن VPN قيد التشغيل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu kompüterdəki port vasitəsilə idarə olunur. Digər proqramlar VPN-in aktiv olduğunu söyləyə biləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ кіруецца праз порт на гэтым кампутары. Іншыя праграмы змогуць вызначыць, што VPN уключаны."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এই কম্পিউটারে একটি পোর্টের মাধ্যমে নিয়ন্ত্রিত হয়। অন্যান্য প্রোগ্রাম বলতে সক্ষম হবে যে একটি VPN চালু আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird über einen Port an diesem Computer gesteuert. Andere Programme können erkennen, dass ein VPN aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is controlled through a port on this computer. Other programs will be able to tell that a VPN is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se controla a través de un puerto en esta computadora. Otros programas podrán saber que hay una VPN activada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ از طریق پورت این کامپیوتر کنترل می شود. سایر برنامه ها می توانند به روشن بودن VPN بگویند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est contrôlé via un port sur cet ordinateur. D'autres programmes pourront détecter qu'un VPN est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को इस कंप्यूटर पर एक पोर्ट के माध्यम से नियंत्रित किया जाता है। अन्य प्रोग्राम यह बताने में सक्षम होंगे कि वीपीएन चालू है।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ը կառավարվում է այս համակարգչի պորտի միջոցով: Այլ ծրագրերը կկարողանան ասել, որ VPN-ը միացված է:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dikontrol melalui port di komputer ini. Program lain akan dapat mengetahui bahwa VPN aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è controllato tramite una porta su questo computer. Altri programmi saranno in grado di dire che una VPN è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、このコンピューターのポートを通じて制御されます。 他のプログラムは、VPN がオンになっていることを認識できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ კონტროლდება ამ კომპიუტერის პორტის მეშვეობით. სხვა პროგრამებს შეეძლებათ თქვან, რომ VPN ჩართულია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ осы компьютердегі порт арқылы басқарылады. Басқа бағдарламалар VPN қосулы екенін айта алады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 컴퓨터의 포트를 통해 제어됩니다. 다른 프로그램에서는 VPN이 켜져 있음을 알 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бул компьютердеги порт аркылуу башкарылат. Башка программалар VPN күйгүзүлгөнүн айта алышат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterowanie %@ odbywa się poprzez port tego komputera. Inne programy będą w stanie stwierdzić, że VPN jest włączony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é controlado por meio de uma porta neste computador. Outros programas serão capazes de dizer que uma VPN está ativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ управляется через порт на этом компьютере. Другие программы смогут заметить, что VPN включён."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тавассути порти ин компютер идора карда мешавад. Барномаҳои дигар метавонанд бигӯянд, ки VPN фаъол аст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกควบคุมผ่านพอร์ตบนคอมพิวเตอร์เครื่องนี้ โปรแกรมอื่นๆ จะสามารถบอกได้ว่า VPN เปิดอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu kompýuterdäki port arkaly dolandyrylýar. Beýleki programmalar bir VPN-iň açykdygyny aýdyp bilerler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu bilgisayardaki bir bağlantı noktası aracılığıyla kontrol ediliyor. Diğer programlar bir VPN'in açık olduğunu anlayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ керується через порт на цьому комп’ютері. Інші програми зможуть визначити, що VPN увімкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو اس کمپیوٹر پر ایک پورٹ کے ذریعے کنٹرول کیا جاتا ہے۔ دوسرے پروگرام یہ بتا سکیں گے کہ VPN آن ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ushbu kompyuterdagi port orqali boshqariladi. Boshqa dasturlar VPN yoqilganligini aniqlay oladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được điều khiển thông qua một cổng trên máy tính này. Các chương trình khác sẽ có thể cho biết VPN đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通过该计算机上的端口进行控制。 其他程序将能够判断 VPN 是否已打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 透過此電腦上的連接埠進行控制。 其他程式將能夠判斷 VPN 是否已開啟。"
          }
        }
      }
    },
