    "speedtestUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء تشغيل المتصفح المضمن. افتح الخدمة في متصفح النظام الخاص بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Quraşdırılmış brauzer başlaya bilmədi. Xidməti sistem brauzerinizdə açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не атрымалася запусціць убудаваны браўзер. Адкрыйце службу ў сістэмным браўзеры."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমবেড করা ব্রাউজারটি শুরু করা যায়নি। আপনার সিস্টেম ব্রাউজারে পরিষেবাটি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingebettete Browser konnte nicht gestartet werden. Öffnen Sie den Dienst in Ihrem Systembrowser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded browser could not start. Open the service in your system browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El navegador integrado no pudo iniciarse. Abra el servicio en el navegador de su sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرورگر تعبیه شده نمی تواند راه اندازی شود. سرویس را در مرورگر سیستم خود باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le navigateur intégré n'a pas pu démarrer. Ouvrez le service dans votre navigateur système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एम्बेडेड ब्राउज़र प्रारंभ नहीं हो सका. अपने सिस्टम ब्राउज़र में सेवा खोलें."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ներկառուցված դիտարկիչը չհաջողվեց գործարկել: Բացեք ծառայությունը ձեր համակարգի բրաուզերում:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser yang tertanam tidak dapat dijalankan. Buka layanan di browser sistem Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il browser incorporato. Apri il servizio nel browser di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み込みブラウザを起動できませんでした。 システムブラウザでサービスを開きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაშენებული ბრაუზერის გაშვება ვერ მოხერხდა. გახსენით სერვისი თქვენი სისტემის ბრაუზერში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізілген браузер іске қосылмады. Жүйе шолғышында қызметті ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장된 브라우저를 시작할 수 없습니다. 시스템 브라우저에서 서비스를 엽니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кыстарылган браузер башталбай койду. Кызматты системаңыздын браузеринде ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić wbudowanej przeglądarki. Otwórz usługę w przeglądarce systemowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O navegador incorporado não pôde ser iniciado. Abra o serviço no navegador do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный браузер не запустился. Откройте сервис в системном браузере."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузери дарунсохт оғоз карда натавонист. Хизматро дар браузери системаи худ кушоед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบราว์เซอร์แบบฝังตัวไม่สามารถเริ่มทำงานได้ เปิดบริการในเบราว์เซอร์ระบบของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Içerki brauzer başlap bilmedi. Hyzmaty ulgam brauzeriňizde açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katıştırılmış tarayıcı başlatılamadı. Hizmeti sistem tarayıcınızda açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити вбудований браузер. Відкрийте службу в системному браузері."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرایت شدہ براؤزر شروع نہیں ہو سکا۔ اپنے سسٹم براؤزر میں سروس کھولیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'rnatilgan brauzer ishga tushmadi. Tizim brauzerida xizmatni oching."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình duyệt được nhúng không thể khởi động. Mở dịch vụ trong trình duyệt hệ thống của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式浏览器无法启动。 在系统浏览器中打开该服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式瀏覽器無法啟動。 在系統瀏覽器中開啟該服務。"
          }
        }
      }
    },
