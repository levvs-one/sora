    "updateDropWarning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف ينقطع اتصال VPN لبضع ثوان أثناء Sora وتحديثه الأساسي. يكمل؟"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora və onun əsas yeniləməsi zamanı VPN bağlantısı bir neçə saniyə kəsiləcək. Davam edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-злучэнне абарвецца на некалькі секунд, пакуль Sora і яго асноўнае абнаўленне. Працягнуць?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora এবং এর মূল আপডেটের সময় VPN সংযোগটি কয়েক সেকেন্ডের জন্য নেমে যাবে। চালিয়ে যান?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VPN-Verbindung wird für einige Sekunden unterbrochen, während Sora und sein Kernupdate durchgeführt werden. Weitermachen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN connection will drop for a few seconds while Sora and its core update. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión VPN se cortará durante unos segundos mientras Sora y su actualización principal. ¿Continuar?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حالی که Sora و به روز رسانی اصلی آن، اتصال VPN برای چند ثانیه قطع می شود. ادامه دهید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion VPN sera interrompue pendant quelques secondes pendant la mise à jour de Sora et de sa base. Continuer?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora और इसके मुख्य अपडेट के दौरान वीपीएन कनेक्शन कुछ सेकंड के लिए बंद हो जाएगा। जारी रखना?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN կապը մի քանի վայրկյանով կնվազի, մինչ Sora-ը և դրա հիմնական թարմացումը: Շարունակե՞լ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi VPN akan terputus selama beberapa detik saat Sora dan pembaruan intinya. Melanjutkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione VPN verrà interrotta per alcuni secondi durante l'aggiornamento di Sora e del suo core. Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora とそのコアの更新中に、VPN 接続が数秒間切断されます。 続く？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN კავშირი შეწყდება რამდენიმე წამით, ხოლო Sora და მისი ძირითადი განახლება. გაგრძელება?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora және оның негізгі жаңартылуы кезінде VPN қосылымы бірнеше секундқа үзіледі. Жалғастыру керек пе?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora 및 핵심 업데이트가 진행되는 동안 VPN 연결이 몇 초 동안 끊어집니다. 계속하다?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora жана анын негизги жаңыртылышы учурунда VPN туташуусу бир нече секундага үзүлөт. Улантасызбы?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie VPN zostanie zerwane na kilka sekund podczas aktualizacji Sora i jego podstawowej wersji. Kontynuować?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão VPN cairá por alguns segundos enquanto Sora e seu núcleo são atualizados. Continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При обновлении Sora и ядра VPN-соединение прервётся на несколько секунд. Продолжить?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми Sora ва навсозии асосии он пайвасти VPN чанд сония қатъ мешавад. Давом додан?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อ VPN จะลดลงไม่กี่วินาทีในขณะที่ Sora และการอัปเดตหลัก ดำเนินการต่อ?"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora we esasy täzelenmesi bilen VPN birikmesi birnäçe sekuntlap ​​pese gaçar. Dowam et?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora ve çekirdeği güncellenirken VPN bağlantısı birkaç saniyeliğine kesilecektir. Devam etmek?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час оновлення Sora та його основного з’єднання VPN-з’єднання припиниться на кілька секунд. Продовжити?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN کنکشن چند سیکنڈز کے لیے گر جائے گا جبکہ Sora اور اس کی بنیادی اپ ڈیٹ۔ جاری رکھیں؟"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sora va uning asosiy yangilanishi vaqtida VPN ulanishi bir necha soniyaga uziladi. Davom ettirilsinmi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối VPN sẽ bị ngắt trong vài giây trong khi Sora và bản cập nhật cốt lõi của nó. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Sora 及其核心更新时，VPN 连接将断开几秒钟。 继续？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Sora 及其核心更新時，VPN 連線將斷開幾秒鐘。 繼續？"
          }
        }
      }
    },
    "updateInstallError": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
