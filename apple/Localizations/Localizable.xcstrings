    "obfsMuxDetail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux sends many streams over one TLS connection to a REALITY server, so the network sees a single handshake. Turn it off only if a server mishandles mux; separate handshakes may stand out more."
          }
        },
        "az": {
