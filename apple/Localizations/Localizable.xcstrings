    "notify.failed.auth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed: the server rejected the credentials. Re-import or update the subscription."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось: сервер отклонил учётные данные. Импортируйте заново или обновите подписку."
          }
        }
      }
    },
    "notify.failed.config": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed: the configuration is not valid for this server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось: конфигурация не подходит для этого сервера."
          }
        }
      }
    },
    "notify.failed.extension": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed: a problem with the network extension. Check its approval in System Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось: проблема с сетевым расширением. Проверьте его одобрение в «Системных настройках»."
          }
        }
      }
    },
    "notify.failed.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed. Details are in Logs in Sora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось. Подробности — в «Журнале» Sora."
          }
        }
      }
    },
    "notify.failed.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed: no network. Sora will retry when a network appears."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось: нет сети. Sora повторит, когда сеть появится."
          }
        }
      }
    },
    "notify.failed.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed: the server did not answer. Try another server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение не удалось: сервер не отвечает. Попробуйте другой сервер."
