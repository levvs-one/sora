    "importSealed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرابط مشفر لـ Happ، ولا يمكن قراءته إلا لـ Happ. اطلب من مزود الخدمة الخاص بك رابط الاشتراك العادي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu keçid Happ üçün şifrələnib və yalnız Happ onu oxuya bilər. Provayderinizdən sadə abunə linkini soruşun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта спасылка зашыфравана для Happ, і толькі Happ можа яе прачытаць. Спытайце ў свайго пастаўшчыка простую спасылку для падпіскі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লিঙ্কটি Happ এর জন্য এনক্রিপ্ট করা হয়েছে এবং শুধুমাত্র Happ এটি পড়তে পারে৷ প্লেইন সাবস্ক্রিপশন লিঙ্কের জন্য আপনার প্রদানকারীকে জিজ্ঞাসা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist für Happ verschlüsselt und kann nur von Happ gelesen werden. Fragen Sie Ihren Anbieter nach dem einfachen Abonnement-Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is encrypted for Happ, and only Happ can read it. Ask your provider for the plain subscription link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace está cifrado para Happ y solo Happ puede leerlo. Pídale a su proveedor el enlace de suscripción simple."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیوند برای Happ رمزگذاری شده است و فقط Happ می تواند آن را بخواند. از ارائه دهنده خود لینک اشتراک ساده را بخواهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien est crypté pour Happ et seul Happ peut le lire. Demandez à votre fournisseur le lien d’abonnement simple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लिंक Happ के लिए एन्क्रिप्ट किया गया है, और केवल Happ ही इसे पढ़ सकता है। सादे सदस्यता लिंक के लिए अपने प्रदाता से पूछें।"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հղումը կոդավորված է Happ-ի համար, և միայն Happ-ն կարող է կարդալ այն: Խնդրեք ձեր մատակարարին պարզ բաժանորդագրության հղումը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan ini dienkripsi untuk Happ, dan hanya Happ yang dapat membacanya. Tanyakan penyedia Anda untuk tautan berlangganan biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo collegamento è crittografato per Happ e solo Happ può leggerlo. Chiedi al tuo provider il semplice collegamento di abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは Happ に対して暗号化されており、Happ のみが読み取ることができます。 プロバイダーにプレーンなサブスクリプション リンクを問い合わせてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ბმული დაშიფრულია Happ-სთვის და მხოლოდ Happ-ს შეუძლია მისი წაკითხვა. სთხოვეთ თქვენს პროვაიდერს უბრალო გამოწერის ბმული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сілтеме Happ үшін шифрланған және оны тек Happ оқи алады. Провайдеріңізден қарапайым жазылым сілтемесін сұраңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 Happ에 대해 암호화되어 있으며 Happ만 읽을 수 있습니다. 일반 구독 링크는 공급자에게 문의하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул шилтеме Happ үчүн шифрленген жана аны Happ гана окуй алат. Провайдериңизден жөнөкөй жазылуу шилтемесин сураңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To łącze jest zaszyfrowane dla Happ i tylko Happ może je odczytać. Poproś swojego dostawcę o zwykły link do subskrypcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link é criptografado para Happ e somente Happ pode lê-lo. Peça ao seu provedor o link de assinatura simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка зашифрована для Happ, прочитать её может только Happ. Попросите у провайдера обычную ссылку на подписку."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин пайванд барои Happ рамзгузорӣ шудааст ва танҳо Happ онро хонда метавонад. Аз провайдери худ истиноди оддии обуна пурсед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์นี้ได้รับการเข้ารหัสสำหรับ Happ และมีเพียง Happ เท่านั้นที่สามารถอ่านได้ สอบถามผู้ให้บริการของคุณเกี่ยวกับลิงค์สมัครสมาชิกธรรมดา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu baglanyşyk Happ üçin kodlanýar we ony diňe Happ okap biler. Adaty abuna baglanyşygy üçin üpjün edijiňizden soraň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı Happ için şifrelenmiştir ve onu yalnızca Happ okuyabilir. Sağlayıcınızdan düz abonelik bağlantısını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це посилання зашифровано для Happ, і лише Happ може його прочитати. Попросіть свого провайдера надати просте посилання для підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لنک Happ کے لیے خفیہ کردہ ہے، اور صرف Happ اسے پڑھ سکتا ہے۔ اپنے فراہم کنندہ سے سادہ سبسکرپشن لنک طلب کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu havola Happ uchun shifrlangan va uni faqat Happ o‘qiy oladi. Provayderingizdan oddiy obuna havolasini so'rang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết này được mã hóa cho Happ và chỉ Happ mới có thể đọc được. Hãy hỏi nhà cung cấp của bạn để có liên kết đăng ký đơn giản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该链接针对Happ进行了加密，只有Happ可以读取。 向您的提供商询问简单的订阅链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結針對Happ進行了加密，只有Happ可以讀取。 向您的提供者詢問簡單的訂閱連結。"
          }
        }
      }
    },
