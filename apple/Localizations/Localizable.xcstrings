        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilash tugamadi. Autentifikatsiya bekor qilingan bo'lishi mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật chưa kết thúc. Xác thực có thể đã bị hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新没有完成。 身份验证可能已被取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新沒有完成。 身份驗證可能已被取消。"
          }
        }
      }
    },
