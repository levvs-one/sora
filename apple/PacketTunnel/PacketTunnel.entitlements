<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Packet Tunnel extension entitlements (draft). The App Group must
     match the app's exactly, or config exchange silently fails — the
     app probes for this (TunnelManager.probeAppGroup). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.levvs-one.sora</string>
	</array>
</dict>
</plist>
