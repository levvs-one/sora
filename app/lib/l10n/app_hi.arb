  "expiresIn": "{name}: {days, plural, =0{सदस्यता कुछ ही घंटों में समाप्त हो जाती है} one{सदस्यता {days} दिन में समाप्त होती है} other{सदस्यता {days} दिनों में समाप्त हो जाती है}}",
