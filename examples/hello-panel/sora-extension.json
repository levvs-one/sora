{
  "manifest_version": 1,
  "id": "org.sora.hello-panel",
  "name": "Hello Panel",
  "version": "1.0.0",
  "min_app_version": "1.9.0",
  "description": "The official example extension: a panel with live connection statistics.",
  "author": {
    "name": "Sora Team",
    "identity": "github:levvs-one",
    "public_key": "RWQAAAAAAAAAAHd26HC5M1TyoLJMI/KjbMToDiIyGMG5eSb90Bg5aiub"
  },
  "permissions": ["connections.read", "notifications"],
  "capabilities": ["ui-panel"],
  "ui": {"panels": [{"id": "main", "title": "Hello", "entry": "panel.html"}]},
  "settings_schema": {
    "type": "object",
    "properties": {
      "refresh_seconds": {"type": "integer", "minimum": 1, "maximum": 60, "default": 5}
    }
  }
}