+// MuxOptions controls stream multiplexing of REALITY outbounds.
+//
+// The "siberian" censorship wave freezes connections when it sees more than
+// three parallel TLS handshakes carrying one SNI. Multiplexing many
+// application streams over a single TLS connection keeps the parallel
+// handshake count at one, cutting that trigger off at the source. It is on
+// by default for REALITY outbounds because a browser-like dest site expects
+// connection reuse (HTTP/2 coalescing) anyway; disabling it must be a
+// deliberate choice.
+type MuxOptions struct {
+	// Disabled turns the REALITY multiplexing default off. Only set this
+	// when the server is known to mishandle mux (some XTLS-Vision
+	// deployments do; Xray ignores mux under xtls-rprx-vision anyway).
+	Disabled bool
+	// Concurrency caps the multiplexed streams per TLS connection
+	// (Xray "concurrency", sing-box "max_streams"). Zero uses the engine
+	// default. Values above ~32 rarely help and can trip server limits.
+	Concurrency int
+}
