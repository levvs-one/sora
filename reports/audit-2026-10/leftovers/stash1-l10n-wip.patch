+func TestRenderPassesXHTTPHeaders(t *testing.T) {
+	p := enginetest.Plan(engine.ProtocolVLESS)
+	p.Outbounds[0].Flow = ""
+	p.Outbounds[0].Transport = engine.Transport{
+		Type: "xhttp", Path: "/x", Mode: "auto",
+		Headers: map[string]string{"User-Agent": "firefox"},
+	}
+	raw, err := Render(p, testRuntime, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), `"headers":{"User-Agent":"firefox"}`) {
+		t.Fatalf("xhttp headers must reach xhttpSettings: %s", raw)
+	}
+
+	// Without headers the key must stay absent: Xray treats an explicit
+	// empty object differently from an omitted one.
+	p.Outbounds[0].Transport.Headers = nil
+	raw, err = Render(p, testRuntime, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(raw), `"headers"`) {
+		t.Fatalf("xhttp headers must be omitted when empty: %s", raw)
+	}
+}
