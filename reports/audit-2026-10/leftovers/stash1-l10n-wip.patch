+		}
+	}
+	if _, err := Decode(base); err != nil {
+		t.Fatalf("base vector must decode: %v", err)
+	}
+	// Unknown extra keys are ignored: forward compatibility for future
+	// fields. Duplicates are still forbidden (see the map above).
+	withExtra := base + "&future_field=1"
+	in, err := Decode(withExtra)
+	if err != nil {
+		t.Fatalf("payload with an unknown key must decode: %v", err)
+	}
+	if in.DeviceID != "device-a" || in.Port != 12345 {
+		t.Fatalf("fields changed by the unknown key: %+v", in)
+	}
+}
