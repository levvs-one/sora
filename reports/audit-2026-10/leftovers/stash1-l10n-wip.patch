+func TestZeroPublicKeyIdentityRejected(t *testing.T) {
+	// A peer presenting an all-zero identity key can never complete a
+	// later DialKnown (no X25519 public key is all zero); the handshake
+	// must reject it instead of recording a dead peer.
+	inv, epriv, err := pairing.Generate("device-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	errCh := make(chan error, 1)
+	go func() {
+		zero := testIdentity("device-a", "A")
+		zero.PublicKey = [32]byte{}
+		_, err := Accept(ctx, a, epriv, inv.Token, zero)
+		errCh <- err
+	}()
+	_, derr := Dial(ctx, b, inv, testIdentity("device-b", "B"))
+	if derr == nil {
+		t.Fatal("zero public key identity must be rejected")
+	}
+	<-errCh
+}
